+    $depth = 0;
+    $length = strlen($source);
+    for ($index = $brace; $index < $length; $index++) {
+        if ($source[$index] === '{') {
+            $depth++;
+        } elseif ($source[$index] === '}') {
+            $depth--;
+            if ($depth === 0) {
+                return substr($source, $start, $index - $start + 1);
