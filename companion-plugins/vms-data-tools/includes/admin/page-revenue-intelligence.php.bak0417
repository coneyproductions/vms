    {
        return 'vms_dt_rr_variation_bucket_overrides';
    }
}

if (!function_exists('vms_dt_rr_allowed_bucket_keys')) {
    function vms_dt_rr_allowed_bucket_keys(): array
    {
        return array_keys(vms_dt_rr_standard_bucket_labels());
