                <div class="vms-dt-compare-row"><span><?php esc_html_e('Previous', 'vms-data-tools'); ?></span><strong><?php echo esc_html(vms_dt_rr_money((int) ($compare_overview['avg_per_event_cents'] ?? 0))); ?></strong></div>
